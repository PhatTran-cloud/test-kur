# Eduba Pipeline — Environment Variables
# Copy to .env và điền values

# ── Gemini ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# ── Kokoro TTS + Captioned Speech (local) ───
# docker run -p 8881:8880 ghcr.io/remsky/kokoro-fastapi-cpu:v0.2.2
# Uses /dev/captioned_speech endpoint — returns audio + word-level timestamps
KOKORO_API_URL=http://localhost:8881/v1/audio/speech
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG_CODE=a

# ── Pipeline ─────────────────────────────────
FPS=30
