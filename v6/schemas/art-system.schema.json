{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:explainer:v6:art-system",
  "type": "object",
  "required": [
    "version",
    "visual_system_id",
    "visual_thesis",
    "audience_question",
    "emotional_arc",
    "candidates",
    "selection_reason",
    "grammar",
    "tokens",
    "motifs",
    "styleframe_coverage"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "visual_system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "visual_thesis": {
      "type": "string",
      "minLength": 1
    },
    "audience_question": {
      "type": "string",
      "minLength": 1
    },
    "emotional_arc": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "concept",
          "tradeoff"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "grammar": {
      "type": "object",
      "required": [
        "palette_roles",
        "shape_language",
        "silhouette_rules",
        "edge_craft",
        "typography",
        "material_language",
        "lighting",
        "depth_compositing",
        "camera_grammar",
        "motion_grammar",
        "vfx_grammar",
        "transition_grammar",
        "sound_relationship"
      ],
      "properties": {
        "palette_roles": {
          "type": "string",
          "minLength": 1
        },
        "shape_language": {
          "type": "string",
          "minLength": 1
        },
        "silhouette_rules": {
          "type": "string",
          "minLength": 1
        },
        "edge_craft": {
          "type": "string",
          "minLength": 1
        },
        "typography": {
          "type": "string",
          "minLength": 1
        },
        "material_language": {
          "type": "string",
          "minLength": 1
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        },
        "depth_compositing": {
          "type": "string",
          "minLength": 1
        },
        "camera_grammar": {
          "type": "string",
          "minLength": 1
        },
        "motion_grammar": {
          "type": "string",
          "minLength": 1
        },
        "vfx_grammar": {
          "type": "string",
          "minLength": 1
        },
        "transition_grammar": {
          "type": "string",
          "minLength": 1
        },
        "sound_relationship": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "required": [
        "palette",
        "shapes",
        "materials",
        "type_roles",
        "lighting",
        "motion"
      ],
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "type_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lighting": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "motion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "motifs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "meaning",
          "transformations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "transformations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "styleframe_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "artifact",
          "review_status"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "unstarted",
              "in_review",
              "approved",
              "rejected"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
